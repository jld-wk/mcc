entry:
  push 6
  store n
  load n
  call factorial
  dbg_dump
  push 0
  exit

factorial:
  load n
  push 1
  sub
  dup
  push 0
  eq
  jmp_f factorial_recursive
  jmp factorial_exit

factorial_recursive:
  store n2
  load n2
  mul
  load n2
  store n
  jmp factorial

factorial_exit:
  pop