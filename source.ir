entry:
-
store 6, n
call factorial
dump_d result

store 10, new_line_c
dump_c new_line_c

exit 0
-

factorial:
-
store n, result
jmp factorial_cond
-

factorial_cond:
-
sub n, 1, n
jmp_if n, 0, ne, factorial_impl
-

factorial_impl:
-
mul result, n, result
jmp factorial_cond
-