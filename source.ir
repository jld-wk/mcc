entry (void):
-
  store 6, [arg:0]
  call factorial
  dump_d [ret:0]

  store 10, [new_line_c]
  dump_c [new_line_c]
  
  exit 0
-

factorial (n):
-
store [n], [result]
jmp cond

cond:
  sub [n], 1, [n]
  jmp_if [n], 0, ne, body
end

body:
  mul [n], [result], [result]
  jmp cond
end

ret [result]
-