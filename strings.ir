entry (void):
-
store 6, [arg:0]
call alloc_char_ptr
store [ret:0], [str_1]

; But whos gonna stop me from calling it str?
store_ptr 72, 0, [str_1]
store_ptr 101, 1, [str_1]
store_ptr 108, 2, [str_1]
store_ptr 108, 3, [str_1]
store_ptr 111, 4, [str_1]
store_ptr 33, 5, [str_1]

store 3, [arg:0]
call alloc_char_ptr
store [ret:0], [str_2]

store_ptr 10, 0, [str_2]
store_ptr 63, 1, [str_2]
store_ptr 10, 2, [str_2]

store [str_1], [arg:0]
call print_char_ptr

store [str_2], [arg:0]
call print_char_ptr

free [str_1]
free [str_2]

exit 0
-

; Yes, it is not a string!
alloc_char_ptr (len):
-
add [len], 1, [n_len]
alloc [n_len], [ptr]
store_ptr 0, [len], [ptr]

ret [ptr]
-

print_char_ptr (ptr):
-
store 0, [c]
jmp cond

cond:
  load_addr [ptr], [c]
  jmp_if [c], 0, ne, loop
end

loop:
  dump_c [c]
  add [ptr], 1, [ptr]
  jmp cond
end
-