entry:
-
store 6, len
call new_str
load str, str0_ptr

store_ptr 72, 0, str0_ptr
store_ptr 101, 1, str0_ptr
store_ptr 108, 2, str0_ptr
store_ptr 108, 3, str0_ptr
store_ptr 111, 4, str0_ptr
store_ptr 33, 5, str0_ptr

store 3, len
call new_str
load str, str1_ptr

store_ptr 10, 0, str1_ptr
store_ptr 63, 1, str1_ptr
store_ptr 10, 2, str1_ptr

store str0_ptr, str
call print_str

store str1_ptr, str
call print_str

free str0_ptr
free str1_ptr

exit 0
-

new_str:
-
add len, 1, n_len
alloc n_len, str
store_ptr 0, len, str
-

print_str:
-
load_addr str, char
jmp_if char, 0, ne, print_str_impl
-

print_str_impl:
-
dump_c char
add str, 1, str
jmp print_str
-
